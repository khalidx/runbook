{
  "name": "@khalidx/runbook",
  "version": "0.7.0",
  "description": "Executable markdown documents that you can run, template, and share!",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalidx/runbook.git"
  },
  "scripts": {
    "prepare": "run-s build:node",
    "dev": "tsx src/cli.ts",
    "clean": "run-s build:node:clean build:native:clean",
    "build": "run-s build:node build:native",
    "build:node": "run-s build:node:*",
    "build:node:clean": "rimraf dist/",
    "build:node:typescript": "tsc",
    "build:native": "run-s build:native:*",
    "build:native:clean": "rimraf exec/",
    "build:native:binaries": "run-s build:native:binaries:*",
    "build:native:binaries:current": "bun build --outfile=exec/runbook --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:linux-x64": "bun build --outfile=exec/runbook-linux-x64 --target=bun-linux-x64 --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:linux-arm64": "bun build --outfile=exec/runbook-linux-arm64 --target=bun-linux-arm64 --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:windows-x64": "bun build --outfile=exec/runbook-windows-x64 --target=bun-windows-x64 --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:darwin-x64": "bun build --outfile=exec/runbook-darwin-x64 --target=bun-darwin-x64 --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:darwin-arm64": "bun build --outfile=exec/runbook-darwin-arm64 --target=bun-darwin-arm64 --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:linux-x64-musl": "bun build --outfile=exec/runbook-linux-x64-musl --target=bun-linux-x64-musl --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:binaries:linux-arm64-musl": "bun build --outfile=exec/runbook-linux-arm64-musl --target=bun-linux-arm64-musl --env=disable --compile --sourcemap --bytecode src/cli.ts",
    "build:native:chmod": "find exec/ -type f -exec chmod 755 {} +",
    "test": "node --test 'dist/**/*.test.js'"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "bin": {
    "runbook": "bin/cli.cjs",
    "rb": "bin/cli.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.@(js|js.map|d.ts)",
    "USAGE.md"
  ],
  "engines": {
    "node": "^20.19.4",
    "npm": "^10.8.2"
  },
  "dependencies": {
    "@inquirer/core": "^10.1.15",
    "@koa/router": "^13.1.1",
    "chalk": "^5.4.1",
    "fuzzy": "^0.1.3",
    "globby": "^14.1.0",
    "handlebars": "^4.7.8",
    "inquirer": "^12.8.2",
    "koa": "^3.0.0",
    "minimist": "^1.2.8",
    "omelette": "^0.4.17",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "strip-ansi": "^7.1.0",
    "tslib": "^2.8.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@types/koa__router": "^12.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.19.9",
    "@types/omelette": "^0.4.5",
    "@types/which": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
